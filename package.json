{
  "name": "metadesk",
  "version": "1.0.0",
  "private": true,
  "description": "MetaDesk - a local GUI for ExifTool on Windows",
  "workspaces": [
    "shared",
    "server",
    "ui",
    "tests-e2e"
  ],
  "scripts": {
    "test": "npm --workspace server test",
    "build": "npm --workspaces --if-present run build",
    "dev": "pwsh -NoProfile -ExecutionPolicy Bypass -File bin/metadesk-dev.ps1",
    "fetch:node": "node scripts/fetch-node.mjs",
    "build:server-bundle": "node scripts/build-server-bundle.mjs",
    "verify:desktop": "node scripts/verify-desktop.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tauri-apps/cli": "^2.12.1",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "husky": "9.1.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
